# PLANTILLA del Secret (Fase 7). Lleva extensión .yaml.example A PROPÓSITO: `kubectl apply -f k8s/`
# no la aplica, así nunca se despliegan valores de ejemplo ni se suben secretos reales al repositorio.
#
# Opción A (recomendada): crearlo desde tu .env local (el .env debe estar en formato LF):
#   kubectl create secret generic carrito-secret -n ecommerce \
#     --from-literal=CLOUDAMQP_URL='amqps://...' \
#     --from-literal=API_USUARIO='modulo_carro' \
#     --from-literal=API_PASSWORD='...' \
#     --from-literal=JWT_SECRET='...'
#
# Opción B: copiar este archivo a k8s/secret.yaml (ya está en .gitignore), rellenar y aplicar.
apiVersion: v1
kind: Secret
metadata:
  name: carrito-secret
  namespace: ecommerce
  labels:
    app: carrito
type: Opaque
stringData:
  CLOUDAMQP_URL: "amqps://USUARIO:PASSWORD@HOST.rmq.cloudamqp.com/VHOST"   # credenciales del BROKER
  API_USUARIO: "modulo_carro"                                               # usuario de servicio ante auth.login
  API_PASSWORD: "CAMBIAR"
  JWT_SECRET: "CAMBIAR_POR_LA_CLAVE_COMPARTIDA_DEL_EQUIPO"                  # misma clave que firma el Grupo F
