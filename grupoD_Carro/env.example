# --- RabbitMQ (CloudAMQP): credenciales del BROKER (no son las de la API) ---
CLOUDAMQP_URL=amqps://USUARIO:PASSWORD@HOST.rmq.cloudamqp.com/VHOST
PEDIDOS_EXCHANGE=pedidos_exchange
PEDIDOS_ROUTING_KEY=pedido.creado

# --- Credenciales de SERVICIO del carrito ante el módulo de autenticación (auth.login) ---
# Con ellas el carrito obtiene un JWT que envía a Clientes y a Pedidos.
API_USUARIO=modulo_carro
API_PASSWORD=CAMBIAR
# true: enviar el JWT de servicio a Pedidos. false: interruptor de emergencia (llamar sin token).
PEDIDOS_USAR_JWT=true

# --- Validación de tokens de la API protegida del carrito (/api/...) ---
# Misma clave compartida con la que el módulo de autenticación (Grupo F) firma los JWT.
# Si no se define, /api/carrito/... responde 503 (falla cerrada); la interfaz web sigue funcionando.
JWT_SECRET=CAMBIAR_POR_LA_CLAVE_COMPARTIDA_DEL_EQUIPO
JWT_ALGORITHM=HS256
#JWT_ISSUER=auth-service
#JWT_CLAIM_ROL=rol
#JWT_CLAIM_CLIENTE_ID=cliente_id

# Solo el cliente id 25 se simula; los demás se consultan al worker real de Clientes.
SIMULAR_CLIENTES=true
