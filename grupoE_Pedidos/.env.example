# Puerto del Microservicio de Pedidos
PORT=3000

# Base de datos (MySQL Workbench)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=pedidos_db
DB_PORT=3306

# RabbitMQ (CloudAMQP o local)
# CloudAMQP: pega la URL 'amqps://usuario:pass@hostname/vhost'
# Local: deja 'amqp://guest:guest@localhost:5672'
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# CONTRATO COMPARTIDO CON LOS DEMÁS GRUPOS (no cambiar sin avisar)
RABBITMQ_EXCHANGE=pedidos_exchange
RABBITMQ_EXCHANGE_TYPE=fanout
RABBITMQ_ROUTING_KEY=pedido.creado

# Cola de auditoría del productor: sirve para ver los mensajes en el panel.
# Ningún consumidor debe leerla; cada grupo crea su propia cola.
RABBITMQ_AUDIT_QUEUE=pedidos_creados_auditoria

# Cola del simulador (npm run test-consumer)
RABBITMQ_CONSUMER_QUEUE=simulador_pedidos_queue

# Autenticación JWT (debe coincidir con el secreto compartido del clúster)
JWT_SECRET=reemplazar_por_secreto_jwt_compartido
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1800

# Credenciales para autenticarse en la cola RPC auth.login de Clientes (Grupo F)
CLIENTES_RPC_USER=demo
CLIENTES_RPC_PASSWORD=demo123
