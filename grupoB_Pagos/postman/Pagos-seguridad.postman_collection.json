{
  "info": {
    "name": "Pagos — Seguridad Semana 9 y 10",
    "description": "Pruebas de solo lectura. Usar tokens del entorno probado; no guardar tokens reales en la colección. Las cookies están desactivadas para que una sesión previa no oculte un 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8086"
    },
    {
      "key": "token_operador",
      "value": ""
    },
    {
      "key": "token_administrador",
      "value": ""
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "token_vencido",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Público sin token",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Protegido sin token",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Token válido operador",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_operador}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Token alterado",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_alterado}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.variables.get('token_operador');",
              "if (!token || token.split('.').length !== 3) throw new Error('Configura token_operador');",
              "const parts = token.split('.');",
              "parts[2] = (parts[2][0] === 'a' ? 'b' : 'a') + parts[2].slice(1);",
              "pm.variables.set('token_alterado', parts.join('.')); "
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Token vencido",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_vencido}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Rol no autorizado cliente",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_cliente}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Rol autorizado operador",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_operador}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Rol autorizado administrador",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_administrador}}"
          }
        ],
        "url": "{{base_url}}/pending.php",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON', () => pm.response.json());"
            ]
          }
        }
      ]
    }
  ]
}
