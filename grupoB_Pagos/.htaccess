Options -Indexes
DirectoryIndex index.php

RewriteEngine On

RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteRule ^(?!public(?:/|$)|index\.php$).+ - [F,L,NC]
RewriteRule ^(?:src|bin|tests|examples|vendor|var|docs)(?:/|$) - [F,L,NC]

<FilesMatch "^(\..*|composer\.(json|lock)|bootstrap\.php|README\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "^_.*\.php$">
    Require all denied
</FilesMatch>