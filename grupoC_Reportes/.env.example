# Broker RabbitMQ compartido (pedir la URL al grupo de Clientes/Pedidos). NO subir el .env a git.
AMQP_URL=

# Respaldo por HTTP si no hay AMQP_URL
CLIENTES_URL=http://localhost:8000

# --- Autenticación JWT (cuentas que entrega cada grupo; NO subir a git) ---
# Clientes (Grupo F): usuario/contraseña de su cola auth.login (en su README usan demo / demo123)
CLIENTES_RPC_USUARIO=
CLIENTES_RPC_PASSWORD=
# Inventario (Grupo H): usuario/contraseña de su cola inventario.login
INVENTARIO_RPC_USUARIO=
INVENTARIO_RPC_PASSWORD=
# Productos (Grupo G): usuario/contraseña de su cola productos.login
PRODUCTOS_RPC_USUARIO=
PRODUCTOS_RPC_PASSWORD=

# API REST de Pedidos (Grupo E)
PEDIDOS_URL=http://localhost:3000
# Pedidos exige un JWT con rol operador o administrador. Vacío = Reportes lo pide solo a /api/auth/token.
# Si Pedidos les entrega un token fijo, pégalo en PEDIDOS_TOKEN.
PEDIDOS_ROL=operador
PEDIDOS_TOKEN=

# Productos (Grupo G) se consulta por RabbitMQ (su worker.py) con la misma AMQP_URL: no hace falta nada más.
# Solo si quisieras usar una API web en su lugar: PRODUCTOS_MODO=http y la dirección en PRODUCTOS_URL.
PRODUCTOS_MODO=
PRODUCTOS_URL=

# API de Inventario (Grupo H): URL base de su servicio, p. ej. http://192.168.1.30:8005
INVENTARIO_URL=

# Umbral de "stock bajo" (mismo criterio que Inventario)
STOCK_BAJO=10

# Segundos entre refrescos de respaldo desde las APIs (0 = apagado)
REFRESCO_SEG=300
