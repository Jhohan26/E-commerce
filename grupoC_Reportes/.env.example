# Broker RabbitMQ compartido (pedir la URL al grupo de Clientes/Pedidos). NO subir el .env a git.
AMQP_URL=

# Respaldo por HTTP si no hay AMQP_URL
CLIENTES_URL=http://localhost:8000

# API REST de Pedidos (Grupo E)
PEDIDOS_URL=http://localhost:3000

# Segundos entre refrescos de respaldo desde las APIs (0 = apagado)
REFRESCO_SEG=300
