{
  "name": "grupo-j-notificaciones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Microservicio académico de Notificaciones del Grupo J",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "publish": "node --env-file-if-exists=.env scripts/publish.js"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "express": "^5.1.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
