{
  "name": "grupo-j-notificaciones",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Microservicio académico de Notificaciones del Grupo J",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "check:k8s": "node scripts/check-manifests.js",
    "test:postman": "node scripts/verify-postman-lab.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "publish": "node --env-file-if-exists=.env scripts/publish.js",
    "check:env": "node scripts/check-env.js"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "yaml": "^2.9.1"
  }
}
