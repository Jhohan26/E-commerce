# Copiar a .env.integracion y reemplazar por los acuerdos reales del equipo.
HOST_PORT=3010
# IP del equipo que tiene el broker compartido; no usar localhost de otro PC.
RABBITMQ_URL=amqp://USUARIO:CLAVE@IP_DEL_BROKER:5672/%2F
RABBITMQ_EXCHANGE=comercio.eventos
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=grupo-j.notificaciones
RABBITMQ_BINDINGS=PedidoCreado,PagoAprobado,PagoRechazado,FacturaGenerada,InventarioInsuficiente
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT_MS=5000
