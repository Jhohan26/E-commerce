HOST_PORT=3010
RABBITMQ_URL=amqps://USUARIO:CONTRASENA@SERVIDOR/VHOST
RABBITMQ_REQUIRE_TLS=true
RABBITMQ_QUEUE=grupo-j.notificaciones
RABBITMQ_SOURCES='[{"exchange":"pedidos_exchange","type":"fanout","keys":[""],"events":["PedidoCreado"]},{"exchange":"ecommerce.eventos","type":"topic","keys":["pago.aprobado","pago.rechazado"],"events":["PagoAprobado","PagoRechazado"]},{"exchange":"inventario_exchange","type":"fanout","keys":[""],"events":["InventarioInsuficiente"]},{"exchange":"facturacion_exchange","type":"fanout","keys":[""],"events":["FacturaGenerada"]}]'
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT_MS=5000
RABBITMQ_HEARTBEAT=30
RABBITMQ_MAX_MESSAGE_BYTES=262144
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_MAX_ATTEMPTS=5
CLIENTES_RPC_TIMEOUT_MS=10000
