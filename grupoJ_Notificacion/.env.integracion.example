# MICROSERVICIO DE NOTIFICACIONES - GRUPO J
# Configuración completa, sin variables de Bunker Gym ni de Next.js.
# Se preservaron los valores originales; una clave vacía puede ser opcional o estar pendiente.
# No compartir secretos. Reiniciar el servicio para aplicar cambios.
# npm start carga .env; para integración con Node utilizar:
# node --env-file=.env.integracion src/index.js
# Con Docker: docker compose --env-file=.env.integracion -f docker-compose.integracion.yml up -d
# HOST_PORT solo aplica a Docker; PORT se utiliza al ejecutar Node directamente.
# Una variable en el archivo no garantiza conectividad ni credenciales válidas.

# SERVIDOR Y DATOS
# Puerto HTTP al ejecutar Node directamente. Docker publica el puerto interno 3000; HOST_PORT define el puerto externo.
PORT=3010

# Puerto publicado en localhost por Docker Compose. No modifica el puerto de npm start.
HOST_PORT=3010

# Ruta SQLite para Node. Compose utiliza /app/data/notificaciones.sqlite y su volumen persistente.
DATABASE_PATH=./data/notificaciones.sqlite

# AUTENTICACIÓN JWT DE NOTIFICACIONES
# Secreto privado para firmar tokens propios. Mínimo 32 bytes; conservar el existente y no compartirlo.
JWT_SECRET=

# Segundos máximos de inactividad de las sesiones propias.
AUTH_IDLE_SECONDS=1800

# Duración máxima de una sesión propia, en segundos.
AUTH_LIFETIME_SECONDS=28800

# Duración en segundos del JWT expedido a otros módulos.
AUTH_MODULE_LIFETIME_SECONDS=1800

# true exige cookies por HTTPS; false corresponde al laboratorio HTTP local.
AUTH_SECURE_COOKIE=false

# INTEGRACIÓN DE IDENTIDAD CON CLIENTES
# local usa cuentas propias; clientes valida el contrato JWT del módulo de Clientes.
USER_AUTH_MODE=local

# Secreto JWT acordado con Clientes. En modo clientes debe tener al menos 32 bytes. No inventarlo.
CLIENTES_JWT_SECRET=

# Emisor exacto del JWT de Clientes; obligatorio cuando USER_AUTH_MODE=clientes.
CLIENTES_JWT_ISSUER=

# Audiencia acordada con Clientes. Vacía si ese contrato no utiliza audiencia.
CLIENTES_JWT_AUDIENCE=

# RABBITMQ: CONEXIÓN Y CONSUMO
# URL AMQP/AMQPS privada del broker. Vacía usa el broker local por defecto; en integración es obligatoria.
RABBITMQ_URL=amqps://USUARIO:CONTRASENA@SERVIDOR/VHOST

# Contraseña del usuario notificaciones del contenedor RabbitMQ local. Vacía conserva el valor de laboratorio de Compose. Debe coincidir con la URL si esta se define.
RABBITMQ_PASSWORD=

# true exige amqps:// para el broker principal y el de Clientes. Compose de integración siempre fuerza true.
RABBITMQ_REQUIRE_TLS=true

# Intervalo de heartbeat del broker, en segundos.
RABBITMQ_HEARTBEAT=30

# Tamaño máximo admitido por mensaje, en bytes.
RABBITMQ_MAX_MESSAGE_BYTES=262144

# Exchange usado si no se define RABBITMQ_SOURCES.
RABBITMQ_EXCHANGE=comercio.eventos

# Tipo del exchange de respaldo: topic, direct o fanout. Debe coincidir con el broker.
RABBITMQ_EXCHANGE_TYPE=topic

# Cola persistente del Grupo J. Sus colas de errores se derivan de este nombre.
RABBITMQ_QUEUE=grupo-j.notificaciones

# Routing keys separadas por comas. Vacía utiliza los tipos de evento del código.
RABBITMQ_BINDINGS=

# JSON en una línea con exchange, type, keys y opcional events. Al definirlo sustituye al exchange y bindings de respaldo. Mantener las routing keys exactas del contrato.
RABBITMQ_SOURCES='[{"exchange":"pedidos_exchange","type":"fanout","keys":[""],"events":["PedidoCreado"]},{"exchange":"pagos_exchange","type":"topic","keys":["pago.aprobado","pago.rechazado"],"events":["PagoAprobado","PagoRechazado"]},{"exchange":"inventario_exchange","type":"fanout","keys":[""],"events":["InventarioInsuficiente"]},{"exchange":"facturacion_exchange","type":"fanout","keys":[""],"events":["FacturaGenerada"]}]'

# Cantidad máxima de mensajes entregados sin confirmar al consumidor.
RABBITMQ_PREFETCH=10

# Espera entre intentos de reconexión al broker, en milisegundos.
RABBITMQ_RECONNECT_MS=5000

# RPC Y SEGURIDAD ENTRE MÓDULOS
# Habilita el consumidor RPC de autenticación propio de Notificaciones.
RABBITMQ_AUTH_RPC_ENABLED=true

# Cola del RPC de inicio de sesión de módulos en Notificaciones.
AUTH_RPC_QUEUE=notificaciones.auth.login

# Cola RPC del envío de eventos de módulos a Notificaciones.
EVENT_RPC_QUEUE=notificaciones.eventos

# Exige JWT válido en los eventos recibidos cuando se activa. Coordinar con los productores.
RABBITMQ_REQUIRE_EVENT_JWT=false

# Broker de RPC de Clientes. Vacía reutiliza RABBITMQ_URL.
CLIENTES_RABBITMQ_URL=

# Cola de inicio de sesión RPC del módulo de Clientes.
CLIENTES_RPC_LOGIN_QUEUE=auth.login

# Cola de consulta RPC de Clientes para obtener datos y destinatarios.
CLIENTES_RPC_QUEUE=cliente.consultar

# Usuario de servicio emitido por Clientes para autenticarse por RPC.
CLIENTES_RPC_USERNAME=

# Contraseña real de ese usuario de servicio. No es la contraseña del broker.
CLIENTES_RPC_PASSWORD=

# Tiempo máximo de espera de respuestas RPC, en milisegundos.
CLIENTES_RPC_TIMEOUT_MS=10000

# CORREO Y REINTENTOS
# Activa el trabajador SMTP. false permite registrar notificaciones sin enviar correo.
EMAIL_ENABLED=false

# Servidor SMTP del proveedor de correo.
SMTP_HOST=smtp.gmail.com

# Puerto SMTP; normalmente 587 con STARTTLS o 465 con TLS directo.
SMTP_PORT=587

# false para STARTTLS en 587; true para TLS directo en 465.
SMTP_SECURE=false

# Cuenta autenticada del remitente SMTP.
SMTP_USER=

# Contraseña SMTP o contraseña de aplicación. El código elimina espacios de este valor.
SMTP_PASSWORD=

# Remitente de los mensajes. Vacío utiliza SMTP_USER.
SMTP_FROM=

# Número máximo de intentos de envío de cada correo.
EMAIL_MAX_ATTEMPTS=5

# Intervalo del trabajador de correo, en milisegundos.
EMAIL_INTERVAL_MS=5000

# HERRAMIENTAS OPCIONALES
# Ruta del ejecutable kubectl para scripts/verify-k8s.js. Vacía utiliza kubectl del PATH.
KUBECTL_BINARY=
