PORT=3000
# Puerto externo de Docker. Cambiar si 3000 está ocupado.
HOST_PORT=3000
DATABASE_PATH=./data/notificaciones.sqlite
# Sin definir URL, Node usa localhost y Docker usa rabbitmq automáticamente.
# Para el broker compartido usar .env.integracion.example.
# RABBITMQ_URL=amqp://notificaciones:local-demo@localhost:5672
# Supuestos sugeridos: acordar nombres y tipo con los demás grupos.
RABBITMQ_EXCHANGE=comercio.eventos
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=grupo-j.notificaciones
# Routing keys separadas por coma. Vacío usa los cinco nombres de evento.
RABBITMQ_BINDINGS=
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT_MS=5000
