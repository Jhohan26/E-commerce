# --- Base de datos propia del microservicio (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=facturacion
# Solo si MySQL se conecta por socket Unix (si lo defines, se ignoran host y puerto):
# DB_SOCKET=/run/mysqld/mysqld.sock

# --- RabbitMQ (CloudAMQP) ---
# Pega aquí la URL que dio el grupo de Pedidos. NO la subas a GitHub.
# Para probar solo en tu equipo (docker compose up -d rabbitmq):
#   RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_URL=amqps://usuario:clave@host.rmq.cloudamqp.com/vhost
# Exchange del grupo de Pagos (de aquí llegan los PagoAprobado). Confirmar el nombre con ellos.
RABBITMQ_EXCHANGE_PAGOS=pagos_exchange
RABBITMQ_EXCHANGE_FACTURACION=facturacion_exchange
RABBITMQ_QUEUE=cola_facturacion

# --- Microservicio de Clientes (consulta síncrona) ---
CLIENTES_URL=http://localhost:8000
