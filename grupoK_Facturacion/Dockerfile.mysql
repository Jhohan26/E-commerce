# MySQL de Facturacion CON el esquema (sql/schema.sql) dentro de la imagen.
#   docker build -f Dockerfile.mysql -t facturacion-mysql:1.0 .
# Al crearse el volumen por primera vez, el entrypoint de MySQL ejecuta 01-schema.sql
# (crea la base facturacion y la tabla Factura). Las claves llegan por variables de entorno
# en tiempo de ejecucion: la imagen no contiene credenciales.
# (El contexto lo filtra Dockerfile.mysql.dockerignore, no el .dockerignore de la aplicacion.)
FROM mysql:8.4

COPY sql/schema.sql /docker-entrypoint-initdb.d/01-schema.sql

# Quita los \r de Windows (CRLF) del esquema
RUN tr -d '\r' < /docker-entrypoint-initdb.d/01-schema.sql > /docker-entrypoint-initdb.d/01-schema.sql.tmp \
    && mv /docker-entrypoint-initdb.d/01-schema.sql.tmp /docker-entrypoint-initdb.d/01-schema.sql \
    && chmod 644 /docker-entrypoint-initdb.d/01-schema.sql
