# --- Base de datos propia del microservicio (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario

# --- RabbitMQ (CloudAMQP) ---
# Pega aquí la URL que dio el grupo de Pedidos. NO la subas a GitHub.
RABBITMQ_URL=amqps://usuario:clave@host.rmq.cloudamqp.com/vhost
RABBITMQ_EXCHANGE_INVENTARIO=inventario_exchange
RABBITMQ_QUEUE=cola_inventario

# --- Interfaz ---
# Unidades por debajo de las cuales se marca "Stock bajo"
STOCK_BAJO=10
