# --- Base de datos propia del microservicio (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario

# --- RabbitMQ (CloudAMQP) ---
# Pega aquí la URL que dio el grupo de Pedidos. NO la subas a GitHub.
RABBITMQ_URL=amqps://usuario:clave@host.rmq.cloudamqp.com/vhost
RABBITMQ_EXCHANGE_INVENTARIO=inventario_exchange
RABBITMQ_QUEUE=cola_inventario

# --- Interfaz ---
# Unidades por debajo de las cuales se marca "Stock bajo"
STOCK_BAJO=10

# --- Módulo de Productos (RPC por RabbitMQ) ---
# URL de la instancia CloudAMQP del grupo de Productos (distinta a la de Pedidos). NO la subas a GitHub.
PRODUCTOS_RABBITMQ_URL=amqps://usuario:clave@host.lmq.cloudamqp.com/vhost
PRODUCTOS_COLA_LISTAR=productos.listar
PRODUCTOS_COLA_CONSULTAR=producto.consultar
PRODUCTOS_RPC_TIMEOUT=8
# Segundos que se reutiliza el catálogo antes de volver a pedirlo
PRODUCTOS_CACHE_SEG=10
